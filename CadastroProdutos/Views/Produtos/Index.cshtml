@model List<CadastroProdutos.Models.Produto>

@{
    ViewData["Title"] = "Produtos";
}

<h1>Cadastro de Produtos</h1>

<p>Bem-vindo ao sistema de gerenciamento de produtos</p>

<button class="btn btn-primary">Novo Produto</button>

<table class="table table-striped table-hover">
<thead>
    <tr>
        <th>ID</th>
        <th>Nome</th>
        <th>Preço</th>
        <th>Estoque</th>
    </tr>
</thead>
<tbody>
    @foreach (var produto in Model)
    {
        <tr>
            <td>@produto.Id</td>
            <td>@produto.Nome</td>
            <td>R$ @produto.Preco.ToString("F2",
            System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</td>
            <td>@produto.Estoque</td>    
        </tr>
    }
</tbody>
</table>